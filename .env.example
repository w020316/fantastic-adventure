# 数据库 - Neon PostgreSQL
# 注册地址: https://neon.tech (免费额度: 0.5GB存储, 100K读/天)
# 创建数据库后，在 Dashboard > Connection Details 获取连接串
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/cyberblog?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# 管理员邮箱（用于种子脚本识别管理员）
ADMIN_EMAIL="admin@cyberblog.dev"

# DeepSeek AI API Key
# 注册地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY="your-deepseek-api-key"
