# ========== 数据库 ==========
# PostgreSQL 连接串（Neon / Supabase / Zeabur 内置 PG）
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ========== NextAuth 认证 ==========
# 必填：JWT 签名密钥，用 `openssl rand -base64 32` 生成
NEXTAUTH_SECRET="your-nextauth-secret-here"
# 必填：站点正式访问地址（含协议），用于回调 URL
NEXTAUTH_URL="https://your-domain.zeabur.app"

# ========== Resend 邮件服务（可选，不配置则联系表单仅入库不发邮件）==========
RESEND_API_KEY="re_xxxxxxxxxxxx"
# 发件人地址（需在 Resend 已验证的域名，否则用默认 onboarding@resend.dev）
RESEND_FROM_EMAIL="onboarding@resend.dev"
# 收件人地址（联系表单提交后通知到哪个邮箱）
CONTACT_EMAIL="1181264839@qq.com"

# ========== AI 聊天（可选）==========
# OpenAI 兼容的 API Key（如用其他服务商，修改对应 base URL）
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ========== GitHub（可选，用于拉取仓库信息展示）==========
GITHUB_TOKEN="ghp_xxxxxxxxxxxx"
GITHUB_USERNAME="w020316"
